# Steel — https://app.steel.dev
# Leave blank to run the whole arena in local mode (no cost, no keys).
STEEL_API_KEY=

# Anthropic — the target agent's brain.
# Leave blank to use the scripted model backend (a test double, not a real model).
ANTHROPIC_API_KEY=

# The model the *target agent* runs on. Levels 1-3 use this; level 4 overrides
# it with LEVEL4_MODEL below.
TARGET_MODEL=claude-sonnet-5
LEVEL4_MODEL=claude-opus-5

# Level 3 runs a separate injection-detector model over untrusted content.
DETECTOR_MODEL=claude-haiku-4-5-20251001

# Where the cred_use tripwire phones home. The web app serves this endpoint at
# /api/tripwire/creds — point it at whatever host the sandbox can reach.
ARENA_CALLBACK_URL=http://127.0.0.1:8080/api/tripwire/creds

# Cost guard: hard ceilings on a single attack run.
MAX_STEPS=12
RUN_TIMEOUT_S=180
