# Steel — https://app.steel.dev
# Leave blank to run the whole arena in local mode (no cost, no keys).
STEEL_API_KEY=

# OpenRouter — the target agent's brain (default real path, ARENA_MODEL=openrouter).
# One key routes to every model. Leave blank to use the scripted backend (a test
# double, not a real model). The models below are the ones FINDINGS.md verified
# actually break under a real defense.
OPENROUTER_API_KEY=

# Anthropic — optional alternative backend (ARENA_MODEL=anthropic). If you use it,
# set TARGET_MODEL/LEVEL4_MODEL/DETECTOR_MODEL to claude-* ids instead.
ANTHROPIC_API_KEY=

# The model the *target agent* runs on. Levels 1-3 use this; level 4 overrides
# it with LEVEL4_MODEL (the hardened wall). Ids are OpenRouter slugs.
TARGET_MODEL=deepseek/deepseek-v3.2
LEVEL4_MODEL=openai/gpt-5-mini

# Level 3 runs a separate injection-detector model over untrusted content.
DETECTOR_MODEL=openai/gpt-4o-mini

# Where the cred_use tripwire phones home. The web app serves this endpoint at
# /api/tripwire/creds — point it at whatever host the sandbox can reach.
ARENA_CALLBACK_URL=http://127.0.0.1:8080/api/tripwire/creds

# Cost guard: hard ceilings on a single attack run.
MAX_STEPS=12
RUN_TIMEOUT_S=180
